docker.runOptions = '-u $(id -u):$(id -g)'
docker.enabled = true
process.scratch = true
conda.enabled = true
nextflow.enable.moduleBinaries = true

params {
    outdir = "results"
    sample_name: "9206-muscle",
    mosdepth_docker: "224597534425.dkr.ecr.us-west-2.amazonaws.com/mosdepth:0.3.1--h4dc83fb_1",
    bedtools_docker: "224597534425.dkr.ecr.us-west-2.amazonaws.com/bedtools:2.23.0--h5b5514e_6",
    deepvariant_docker: "224597534425.dkr.ecr.us-west-2.amazonaws.com/deepvariant:1.3.0",
    alignment:  "/var/snap/amazon-ssm-agent/11797/download/data/9206-muscle_S4.hg38_rna.normal.cram",
    alignment_index: "/var/snap/amazon-ssm-agent/11797/download/data/9206-muscle_S4.hg38_rna.normal.cram.crai",
    fasta: "/var/snap/amazon-ssm-agent/11797/download/GRCh38/GRCh38.primary_assembly.genome.fa",
    fai: "/var/snap/amazon-ssm-agent/11797/download/GRCh38/GRCh38.primary_assembly.genome.fa.fai",
    gencode_bed: "/var/snap/amazon-ssm-agent/11797/download/data/gencode.v48.basic.annotation.cds.bed",
    min_coverage: 3,
    model_data: "/var/snap/amazon-ssm-agent/11797/download/data/model.ckpt.data-00000-of-00001",
    model_index: "/var/snap/amazon-ssm-agent/11797/download/data/model.ckpt.index",
    model_meta: "/var/snap/amazon-ssm-agent/11797/download/data/model.ckpt.meta"
}

manifest {
    nextflowVersion = '!>=22.04.0'
}

process {

    withLabel: 'mosdepth' {
        container = params.mosdepth_docker
    }

    withLabel: 'bedtools_merge_intersect' {
        container = params.bedtools_docker
    }

    withLabel: 'deepvariant_rundeepvariant' {
        container = params.deepvariant_docker
    }
}